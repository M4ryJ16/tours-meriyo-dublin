---
interface Review {
  text: string;
  name: string;
  origin: string;
}

interface Tour {
  name: string;
  desc: string;
  icon: string;
  image: string;
  review: Review;
}

const tours: Tour[] = [
  {
    name: "Casco Histórico",
    desc: "Del Castillo de Dublín a Temple Bar: la ciudad medieval, sus leyendas vikingas y los rincones que la mayoría se salta.",
    icon: "castle",
    image: "https://commons.wikimedia.org/wiki/Special:FilePath/Dublin_Castle_Record_Tower_01.JPG?width=900",
    review: {
      text: "Nuestra guía conocía cada callejón y cada historia. Se nota el cariño por la ciudad — el mejor free tour que hemos hecho en Europa.",
      name: "Marta G.",
      origin: "Sevilla, España",
    },
  },
  {
    name: "Vikinga y Medieval",
    desc: "Sigue el rastro de los fundadores nórdicos de Dublín, desde la Christ Church hasta las murallas que aún respiran bajo la ciudad.",
    icon: "longship",
    image: "https://commons.wikimedia.org/wiki/Special:FilePath/Christ_Church_Cathedral,_Dublin_exterior.jpg?width=900",
    review: {
      text: "Ritmo pausado, grupo pequeño y anécdotas que no salen en las guías. Volvería a repetir sin dudarlo.",
      name: "Tomás R.",
      origin: "Ciudad de México",
    },
  },
  {
    name: "Trinity y Rincones Literarios",
    desc: "Un paseo por el Dublín de Joyce y Wilde: patios centenarios, librerías escondidas y la biblioteca que enamora a cualquiera.",
    icon: "book",
    image: "https://commons.wikimedia.org/wiki/Special:FilePath/Long_Room_Interior,_Trinity_College_Dublin,_Ireland_-_Diliff.jpg?width=900",
    review: {
      text: "Como amante de la literatura, esta ruta fue un regalo. La pasión del guía por Dublín se contagia enseguida.",
      name: "Aoife & Liam",
      origin: "Cork, Irlanda",
    },
  },
];
---

<section class="tours" id="excursiones">
  <div class="wrap">
    <p class="eyebrow tours__eyebrow">Nuestras rutas</p>
    <h2 class="tours__title">Vive Dublín a pie</h2>

    <div class="tours__grid" id="opiniones">
      {tours.map((t) => (
        <article class="card reveal" tabindex="0">
          <!-- Front face: photo with title burned into the image -->
          <div class="card__media" style={`background-image:url(${t.image})`}>
            <div class="card__media-scrim"></div>
            <h3 class="card__media-title">{t.name}</h3>
            <span class="card__hint">Pasa el cursor para ver más</span>
          </div>

          <!-- Back face: full info shown on hover / focus -->
          <div class="card__overlay">
            <h3 class="card__name">{t.name}</h3>
            <p class="card__desc">{t.desc}</p>

            <button class="btn orange-btn">RESERVAR</button>

            <div class="card__review">
              <div class="card__stars" aria-label="5 de 5 estrellas">
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 20 20" width="13" height="13" fill="var(--gold)">
                    <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5Z"/>
                  </svg>
                ))}
              </div>
              <p class="card__quote">&ldquo;{t.review.text}&rdquo;</p>
              <p class="card__reviewer">{t.review.name} <span>— {t.review.origin}</span></p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .tours {
    background: var(--parchment);
    padding-block: 90px 100px;
  }

  .tours__eyebrow { color: var(--russet); }

  .tours__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    margin: 10px 0 44px;
    color: var(--ink);
  }

  .tours__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .card {
    position: relative;
    height: 440px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    background: var(--cream);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    cursor: pointer;
  }
  .card.is-visible { opacity: 1; transform: translateY(0); }

  /* ---------- Front: image + title ---------- */
  .card__media {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 26px 26px 22px;
    transition: transform 0.6s ease, opacity 0.4s ease;
  }

  .card__media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 14, 10, 0.88) 0%,
      rgba(10, 14, 10, 0.25) 55%,
      rgba(10, 14, 10, 0.15) 100%
    );
  }

  .card__media-icon {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--forest-deep);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .card__media-title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .card__hint {
    position: relative;
    margin-top: 10px;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.9;
  }

  /* ---------- Back: full content, revealed on hover ---------- */
  .card__overlay {
    position: absolute;
    inset: 0;
    background: var(--cream);
    padding: 30px 28px 28px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }

  .card:hover .card__overlay,
  .card:focus-within .card__overlay,
  .card:focus .card__overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .card:hover .card__media,
  .card:focus-within .card__media,
  .card:focus .card__media {
    opacity: 0;
    transform: scale(1.04);
  }

  .card__icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--forest-deep);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .card__name {
    font-family: var(--font-display);
    font-size: 1.28rem;
    margin: 0 0 10px;
    color: var(--ink);
  }

  .card__desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #3c4a3d;
    margin: 0 0 18px;
  }

  .card__review {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px dashed rgba(24, 34, 25, 0.18);
  }

  .card__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 8px;
  }

  .card__quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .card__reviewer {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0;
    color: var(--russet);
  }
  .card__reviewer span {
    font-weight: 400;
    color: #6b6355;
  }

  @media (max-width: 940px) {
    .tours__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .tours__grid { grid-template-columns: 1fr; }
    .card { height: 400px; }
  }
</style>

<script>
  const items = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  items.forEach((el) => io.observe(el));
</script>