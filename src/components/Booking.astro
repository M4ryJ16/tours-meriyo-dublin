---
import { getTours, getCurrentCustomer } from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";

interface ApiTour {
  id: string;
  name: string;
  price: string;
  capacity: number;
  currency: string;
  is_active: boolean;
}

interface CurrentCustomer {
  id: string;
  full_name: string;
  email: string;
  phone: string | null;
}

let tours: ApiTour[] = [];
let loadError = false;

try {
  tours = await getTours({ active: true });
} catch (err) {
  console.error('Failed to load tours from the API', err);
  loadError = true;
}

// If the visitor already has a valid session, skip asking for their name/
// email again and book straight under their account.
let currentCustomer: CurrentCustomer | null = null;
const sessionToken = getSessionToken(Astro.cookies);
if (sessionToken) {
  try {
    currentCustomer = await getCurrentCustomer(sessionToken);
  } catch {
    // Expired/invalid token — clear it and fall back to the guest flow,
    // which re-authenticates (or registers) them on submit.
    clearSessionCookie(Astro.cookies);
  }
}

const preselectedTour = Astro.url.searchParams.get("tour") ?? "";
---

<section class="booking" id="reserva">
  <div class="wrap">
    <p class="eyebrow booking__eyebrow">Reserva tu plaza</p>
    <h1 class="booking__title">Vive Dublín a tu ritmo</h1>

    {loadError && (
      <p class="booking__notice">
        No hemos podido cargar las rutas disponibles. Recarga la página o inténtalo más tarde.
      </p>
    )}

    {!loadError && (
    <div class="booking__grid">
      <!-- ============ FORM COLUMN ============ -->
      <form class="booking__form" id="booking-form" novalidate data-authenticated={currentCustomer ? "true" : "false"}>
        <!-- 1. Tour details -->
        <div class="booking__card">
          <h2 class="booking__card-title"><span class="booking__num">01</span>El tour</h2>

          <div class="field">
            <label for="tour">Selecciona tu ruta<em>*</em></label>
            <div class="select-wrap">
              <select id="tour" name="tour" required>
                <option value="" disabled selected={!preselectedTour}>Elige una ruta</option>
                {tours.map((t) => (
                  <option
                    value={t.id}
                    data-price={t.price}
                    data-currency={t.currency}
                    data-capacity={t.capacity}
                    selected={t.id === preselectedTour}
                  >
                    {t.name} — desde {Number(t.price).toFixed(2)} {t.currency}/persona
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="fecha">Fecha<em>*</em></label>
              <input type="date" id="fecha" name="fecha" required />
            </div>
            <div class="field">
              <label for="hora">Hora de inicio<em>*</em></label>
              <div class="select-wrap">
                <select id="hora" name="hora" required disabled>
                  <option value="" selected>Elige primero una ruta</option>
                </select>
              </div>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="guests">Número de personas<em>*</em></label>
              <div class="stepper">
                <button type="button" class="stepper__btn" id="guests-minus" aria-label="Restar persona">−</button>
                <input type="number" id="guests" name="guests" min="1" max="15" value="2" readonly />
                <button type="button" class="stepper__btn" id="guests-plus" aria-label="Añadir persona">+</button>
              </div>
            </div>
          </div>

          <p class="field__notice is-hidden" id="availability-notice" role="status"></p>
        </div>

        <!-- 2. Your details -->
        <div class="booking__card">
          <h2 class="booking__card-title"><span class="booking__num">02</span>Tus datos</h2>

          {currentCustomer ? (
            <div class="booking__account" id="account-summary">
              <p class="booking__account-label">Reservando como</p>
              <p class="booking__account-name">{currentCustomer.full_name}</p>
              <p class="booking__account-email">{currentCustomer.email}</p>
              <button type="button" class="link-btn" id="logout-btn">¿No eres tú? Cambiar de cuenta</button>
            </div>
          ) : (
            <div id="guest-fields">
              <div class="field-row">
                <div class="field">
                  <label for="nombre">Nombre<em>*</em></label>
                  <input type="text" id="nombre" name="nombre" required />
                </div>
                <div class="field">
                  <label for="apellidos">Apellidos<em>*</em></label>
                  <input type="text" id="apellidos" name="apellidos" required />
                </div>
              </div>

              <div class="field-row">
                <div class="field">
                  <label for="email">Correo electrónico<em>*</em></label>
                  <input type="email" id="email" name="email" required />
                </div>
                <div class="field">
                  <label for="telefono">Teléfono <span class="field__optional">(opcional)</span></label>
                  <input type="tel" id="telefono" name="telefono" />
                </div>
              </div>

              <p class="booking__account-hint">
                Te enviaremos un código de un solo uso para confirmar tu correo — no hace falta
                contraseña. Si ya tienes cuenta, entrarás automáticamente.
              </p>
            </div>
          )}
        </div>

        <!-- 3. Final step -->
        <div class="booking__card">
          <h2 class="booking__card-title"><span class="booking__num">03</span>Último paso</h2>
          <label class="checkbox-row">
            <input type="checkbox" id="terminos" name="terminos" required />
            <span>He leído y acepto las <a href="#terminos">Condiciones de reserva</a></span>
          </label>
          <p class="booking__fineprint">
            Al confirmar, reservamos tu plaza para la ruta y fecha elegidas.
          </p>
          <p class="booking__form-error is-hidden" id="form-error" role="alert"></p>
        </div>
      </form>

      <!-- ============ SUMMARY COLUMN ============ -->
      <aside class="summary" aria-live="polite">
        <div class="summary__inner">
          <h2 class="summary__title">Resumen de tu reserva</h2>

          <dl class="summary__list">
            <div class="summary__row">
              <dt>Ruta</dt>
              <dd id="s-tour">—</dd>
            </div>
            <div class="summary__row">
              <dt>Fecha</dt>
              <dd id="s-fecha">—</dd>
            </div>
            <div class="summary__row">
              <dt>Hora</dt>
              <dd id="s-hora">—</dd>
            </div>
            <div class="summary__row">
              <dt>Personas</dt>
              <dd id="s-guests">2</dd>
            </div>
          </dl>

          <div class="summary__divider"></div>

          <div class="summary__row summary__row--total">
            <dt>Precio estimado</dt>
            <dd id="s-total">—</dd>
          </div>

          <button type="submit" form="booking-form" class="btn orange-btn summary__cta" id="submit-btn">
            Confirmar reserva
          </button>
        </div>
      </aside>
    </div>

    <!-- ============ VERIFICATION MODAL (guest flow only) ============ -->
    <div class="overlay is-hidden" id="verify-overlay">
      <div class="panel" role="dialog" aria-modal="true" aria-labelledby="verify-title">
        <div class="panel__head">
          <h2 class="panel__title" id="verify-title">Confirma tu correo</h2>
          <button type="button" class="panel__close" id="verify-close" aria-label="Cerrar">✕</button>
        </div>

        <p class="booking__account-hint" id="verify-sent-to"></p>

        <form id="verify-form" novalidate>
          <div class="field">
            <label for="verify-code">Código de verificación<em>*</em></label>
            <input type="text" id="verify-code" inputmode="numeric" autocomplete="one-time-code" required />
          </div>
          <p class="panel__error is-hidden" id="verify-error" role="alert"></p>
          <div class="panel__actions">
            <button type="button" class="link-btn" id="verify-resend">Reenviar código</button>
            <button type="submit" class="btn orange-btn" id="verify-submit">Verificar y reservar</button>
          </div>
        </form>
      </div>
    </div>
    )}
  </div>
</section>

<style>
  .booking {
    background: var(--parchment);
    padding-block: 56px 100px;
  }

  .booking__eyebrow { color: var(--russet); }

  .booking__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    margin: 10px 0 28px;
    color: var(--ink);
  }

  .booking__notice {
    font-size: 0.95rem;
    color: #5a6b5c;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.12);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin: 0 0 32px;
  }

  .booking__grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 32px;
    align-items: start;
  }

  .booking__form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .booking__card {
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 30px 30px 32px;
  }

  .booking__card-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    margin: 0 0 22px;
  }

  .booking__num {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .field { margin-bottom: 18px; }
  .field:last-child { margin-bottom: 0; }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4a5b4c;
    margin-bottom: 7px;
  }
  label em {
    font-style: normal;
    color: var(--russet);
    margin-left: 2px;
  }
  .field__optional {
    font-weight: 400;
    color: #8a8272;
  }

  .field__notice {
    margin: -6px 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--russet);
  }
  .field__notice.is-hidden { display: none; }
  .field__notice--ok { color: #2e5c30; }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  input[type="date"],
  input[type="number"],
  select {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    padding: 12px 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  input:focus, select:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16);
  }

  select:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .select-wrap { position: relative; }
  select { appearance: none; padding-right: 34px; cursor: pointer; }
  .select-wrap::after {
    content: "";
    position: absolute;
    right: 14px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.6px solid var(--russet);
    border-bottom: 1.6px solid var(--russet);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .stepper {
    display: flex;
    align-items: center;
    border: 1px solid rgba(24, 34, 25, 0.22);
    border-radius: var(--radius);
    overflow: hidden;
    width: fit-content;
  }
  .stepper__btn {
    width: 40px;
    height: 44px;
    border: none;
    background: var(--parchment-alt);
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .stepper__btn:hover { background: var(--gold-soft); }
  .stepper__btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .stepper input {
    width: 56px;
    height: 44px;
    text-align: center;
    border: none;
    border-left: 1px solid rgba(24, 34, 25, 0.14);
    border-right: 1px solid rgba(24, 34, 25, 0.14);
    border-radius: 0;
    background: var(--cream);
  }

  .checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--ink);
    margin-bottom: 12px;
    cursor: pointer;
  }
  .checkbox-row input { margin-top: 3px; accent-color: var(--gold); }
  .checkbox-row a { color: var(--russet); text-decoration: underline; }

  .booking__fineprint {
    font-size: 0.8rem;
    line-height: 1.55;
    color: #7a7562;
    margin: 0;
  }

  .booking__form-error {
    margin-top: 16px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #7a2e1f;
    background: rgba(158, 73, 54, 0.1);
    border-left: 3px solid var(--russet);
    padding: 10px 14px;
    border-radius: var(--radius);
  }
  .booking__form-error.is-hidden { display: none; }

  /* ---------- Logged-in account summary (replaces guest fields) ---------- */
  .booking__account {
    background: var(--parchment-alt);
    border: 1px dashed rgba(24, 34, 25, 0.18);
    border-radius: var(--radius);
    padding: 16px 18px;
  }
  .booking__account-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #7a7562;
    margin: 0 0 4px;
  }
  .booking__account-name {
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 2px;
  }
  .booking__account-email {
    font-size: 0.88rem;
    color: #5a6b5c;
    margin: 0 0 10px;
  }
  .booking__account-hint {
    font-size: 0.82rem;
    color: #7a7562;
    line-height: 1.5;
    margin: 14px 0 0;
  }

  .link-btn {
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--russet);
    cursor: pointer;
    padding: 4px 0;
  }
  .link-btn:hover { text-decoration: underline; }
  .link-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ---------- Verification modal ---------- */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 14, 10, 0.5);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 8vh 20px;
    z-index: 100;
    overflow-y: auto;
  }
  .overlay.is-hidden { display: none; }

  .panel {
    width: 100%;
    max-width: 420px;
    background: var(--cream);
    border-radius: var(--radius);
    border-top: 3px solid var(--gold);
    padding: 26px 28px 28px;
  }
  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .panel__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--ink);
    margin: 0;
  }
  .panel__close {
    background: none;
    border: none;
    font-size: 1.1rem;
    color: #7a7562;
    cursor: pointer;
    line-height: 1;
  }
  .panel__error {
    font-size: 0.85rem;
    color: #7a2e1f;
    background: rgba(158, 73, 54, 0.1);
    border-left: 3px solid var(--russet);
    padding: 10px 14px;
    border-radius: var(--radius);
    margin: 12px 0 0;
  }
  .panel__error.is-hidden { display: none; }
  .panel__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }

  /* ---------- Summary ---------- */
  .summary {
    position: sticky;
    top: 96px;
  }
  .summary__inner {
    background: var(--forest-deep);
    color: var(--parchment-alt);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    padding: 30px 28px;
  }
  .summary__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--cream);
    margin: 0 0 20px;
  }
  .summary__list { margin: 0; }
  .summary__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.88rem;
    padding: 9px 0;
    border-bottom: 1px dashed rgba(242, 234, 215, 0.16);
  }
  .summary__row dt { color: rgba(242, 234, 215, 0.65); margin: 0; font-weight: 400; }
  .summary__row dd { margin: 0; color: var(--cream); font-weight: 500; text-align: right; }

  .summary__divider {
    height: 1px;
    background: rgba(242, 234, 215, 0.16);
    margin: 18px 0;
  }

  .summary__row--total dt,
  .summary__row--total dd {
    font-weight: 600;
    color: var(--cream);
    border: none;
  }
  .summary__row--total { border: none; padding-top: 0; }

  .summary__cta {
    width: 100%;
    justify-content: center;
    margin-top: 22px;
    font-size: 0.95rem;
  }
  .summary__cta:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .summary__note {
    text-align: center;
    font-size: 0.74rem;
    color: rgba(242, 234, 215, 0.55);
    margin: 12px 0 0;
  }

  @media (max-width: 980px) {
    .booking__grid { grid-template-columns: 1fr; }
    .summary { position: static; }
  }

  @media (max-width: 640px) {
    .field-row { grid-template-columns: 1fr; }
    .booking__card { padding: 24px 20px 26px; }
  }
</style>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;

  if (form) {
    const isAuthenticated = form.dataset.authenticated === 'true';

    const tourSelect = document.getElementById('tour') as HTMLSelectElement;
    const fechaInput = document.getElementById('fecha') as HTMLInputElement;
    const horaSelect = document.getElementById('hora') as HTMLSelectElement;
    const guestsInput = document.getElementById('guests') as HTMLInputElement;
    const guestsMinus = document.getElementById('guests-minus') as HTMLButtonElement;
    const guestsPlus = document.getElementById('guests-plus') as HTMLButtonElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const formError = document.getElementById('form-error') as HTMLParagraphElement;
    const availabilityNotice = document.getElementById('availability-notice') as HTMLParagraphElement;

    // Only present when the visitor isn't logged in — see the server-rendered
    // guest-fields branch in this component.
    const nombreInput = document.getElementById('nombre') as HTMLInputElement | null;
    const apellidosInput = document.getElementById('apellidos') as HTMLInputElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const telefonoInput = document.getElementById('telefono') as HTMLInputElement | null;

    const sTour = document.getElementById('s-tour')!;
    const sFecha = document.getElementById('s-fecha')!;
    const sHora = document.getElementById('s-hora')!;
    const sGuests = document.getElementById('s-guests')!;
    const sTotal = document.getElementById('s-total')!;

    // Cache of schedules already fetched per tour, keyed by tour id, so
    // flipping back and forth between routes doesn't re-fetch every time.
    const scheduleCache = new Map<string, { id: string; time: string }[]>();
    let scheduleRequestToken = 0;

    // Cache of availability checks, keyed by tour+date+schedule, plus the
    // result for whatever combination is currently selected. Availability
    // is a best-effort hint for the UI — the server still enforces it
    // authoritatively when the booking is actually submitted.
    const availabilityCache = new Map<string, { remaining: number | null; capacity: number | null }>();
    let currentAvailability: { remaining: number | null; capacity: number | null } | null = null;
    let availabilityRequestToken = 0;

    const formatDate = (value: string) => {
      if (!value) return '—';
      const d = new Date(value + 'T00:00:00');
      return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
    };

    // tour_schedules.time comes back from the API as "HH:MM:SS" — trim
    // the seconds for display.
    const formatTime = (value: string) => value?.slice(0, 5) ?? value;

    function getCurrentCapacity(): number {
      const selected = tourSelect.selectedOptions[0];
      const cap = Number(selected?.dataset.capacity);
      const tourCapacity = Number.isFinite(cap) && cap > 0 ? cap : 15; // fallback if no tour selected yet

      if (currentAvailability && currentAvailability.remaining !== null) {
        return Math.max(Math.min(tourCapacity, currentAvailability.remaining), 0);
      }
      return tourCapacity;
    }

    async function loadSchedulesForSelectedTour() {
      const tourId = tourSelect.value;
      const thisRequest = ++scheduleRequestToken;

      horaSelect.innerHTML = '';
      if (!tourId) {
        horaSelect.disabled = true;
        horaSelect.append(new Option('Elige primero una ruta', ''));
        updateSummary();
        return;
      }

      horaSelect.disabled = true;
      horaSelect.append(new Option('Cargando horarios…', ''));

      let schedules = scheduleCache.get(tourId);
      if (!schedules) {
        try {
          const res = await fetch(`/api/tours/${tourId}/schedules`);
          if (!res.ok) throw new Error('Failed to load schedules');
          schedules = await res.json();
          scheduleCache.set(tourId, schedules ?? []);
        } catch {
          schedules = [];
        }
      }

      // A newer request has since started (the user changed the tour
      // again) — drop this stale response instead of overwriting the
      // select with outdated options.
      if (thisRequest !== scheduleRequestToken) return;

      horaSelect.innerHTML = '';
      if (!schedules || schedules.length === 0) {
        horaSelect.disabled = true;
        horaSelect.append(new Option('No hay horarios disponibles para esta ruta', ''));
        updateSummary();
        return;
      }

      horaSelect.disabled = false;
      horaSelect.append(new Option('Elige una hora', '', true, true));
      horaSelect.options[0].disabled = true;
      for (const schedule of schedules) {
        horaSelect.append(new Option(formatTime(schedule.time), schedule.id));
      }
      updateSummary();
    }

    // Checks remaining spots for the currently selected tour + date + hora.
    // No-ops (and clears the notice) until all three are chosen.
    async function checkAvailability() {
      const tourId = tourSelect.value;
      const date = fechaInput.value;
      const scheduleId = horaSelect.value;
      const thisRequest = ++availabilityRequestToken;

      if (!tourId || !date || !scheduleId) {
        currentAvailability = null;
        availabilityNotice.classList.add('is-hidden');
        updateSummary();
        return;
      }

      const cacheKey = `${tourId}|${date}|${scheduleId}`;
      let availability = availabilityCache.get(cacheKey);

      if (!availability) {
        try {
          const res = await fetch(
            `/api/tours/${tourId}/availability?date=${encodeURIComponent(date)}&scheduleId=${encodeURIComponent(scheduleId)}`
          );
          if (!res.ok) throw new Error('Failed to load availability');
          availability = await res.json();
          availabilityCache.set(cacheKey, availability!);
        } catch {
          // Don't block the user on a failed check — the real enforcement
          // happens server-side when the booking is submitted.
          if (thisRequest === availabilityRequestToken) {
            currentAvailability = null;
            availabilityNotice.classList.add('is-hidden');
            updateSummary();
          }
          return;
        }
      }

      // A newer check has since started — drop this stale response.
      if (thisRequest !== availabilityRequestToken) return;

      currentAvailability = availability!;

      if (availability!.remaining !== null) {
        if (availability!.remaining <= 0) {
          availabilityNotice.textContent = 'No quedan plazas para esta fecha y hora. Elige otra.';
          availabilityNotice.classList.remove('is-hidden', 'field__notice--ok');
        } else if (availability!.remaining <= 5) {
          availabilityNotice.textContent = `Solo quedan ${availability!.remaining} plaza(s) para esta salida.`;
          availabilityNotice.classList.remove('is-hidden');
          availabilityNotice.classList.add('field__notice--ok');
        } else {
          availabilityNotice.classList.add('is-hidden');
        }
      } else {
        availabilityNotice.classList.add('is-hidden');
      }

      updateSummary();
    }

    function updateSummary() {
      const selected = tourSelect.selectedOptions[0];
      const hasTour = Boolean(selected?.value);
      const price = Number(selected?.dataset.price ?? 0);
      const currency = selected?.dataset.currency ?? 'EUR';

      const capacity = getCurrentCapacity();
      const effectiveMax = Math.max(capacity, 1);
      guestsInput.max = String(effectiveMax);
      if (Number(guestsInput.value) > effectiveMax) {
        guestsInput.value = String(effectiveMax);
      }

      const guests = Number(guestsInput.value || 1);
      const total = price * guests;

      const selectedSchedule = horaSelect.selectedOptions[0];
      const soldOut = Boolean(
        currentAvailability && currentAvailability.remaining !== null && currentAvailability.remaining <= 0
      );

      sTour.textContent = hasTour ? selected!.textContent?.split(' — ')[0] ?? '' : '—';
      sFecha.textContent = formatDate(fechaInput.value);
      sHora.textContent = selectedSchedule?.value ? selectedSchedule.textContent ?? '—' : '—';
      sGuests.textContent = String(guests);
      sTotal.textContent = hasTour ? `${total.toFixed(2)} ${currency}` : '—';

      submitBtn.disabled = soldOut;
      guestsPlus.disabled = soldOut;
    }

    guestsMinus.addEventListener('click', () => {
      guestsInput.value = String(Math.max(1, Number(guestsInput.value) - 1));
      updateSummary();
    });
    guestsPlus.addEventListener('click', () => {
      const max = getCurrentCapacity();
      if (max < 1) return; // sold out — nothing to add
      guestsInput.value = String(Math.min(max, Number(guestsInput.value) + 1));
      updateSummary();
    });

    tourSelect.addEventListener('change', () => {
      currentAvailability = null;
      availabilityNotice.classList.add('is-hidden');
      loadSchedulesForSelectedTour();
    });
    [fechaInput, horaSelect].forEach((el) =>
      el.addEventListener('change', () => {
        updateSummary();
        checkAvailability();
      })
    );

    function showError(message: string) {
      formError.textContent = message;
      formError.classList.remove('is-hidden');
    }
    function clearError() {
      formError.textContent = '';
      formError.classList.add('is-hidden');
    }
    function setSubmitting(isSubmitting: boolean) {
      submitBtn.disabled = isSubmitting;
      submitBtn.textContent = isSubmitting ? 'Confirmando…' : 'Confirmar reserva';
    }

    async function submitBooking(payload: Record<string, unknown>) {
      try {
        const res = await fetch('/api/bookings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok) {
          return { ok: false as const, message: data?.message ?? 'No se ha podido completar la reserva.' };
        }
        return { ok: true as const, data };
      } catch {
        return {
          ok: false as const,
          message: 'No se ha podido conectar con el servidor. Comprueba tu conexión e inténtalo de nuevo.'
        };
      }
    }

    // --- Verification modal (guest flow only) ---
    let pendingBooking: Record<string, unknown> | null = null;
    let pendingIdentity: { fullName: string; email: string; phone?: string } | null = null;
    let pendingMode: 'login' | 'register' | null = null;

    const verifyOverlay = document.getElementById('verify-overlay');
    const verifySentTo = document.getElementById('verify-sent-to') as HTMLParagraphElement | null;
    const verifyForm = document.getElementById('verify-form') as HTMLFormElement | null;
    const verifyCodeInput = document.getElementById('verify-code') as HTMLInputElement | null;
    const verifyError = document.getElementById('verify-error') as HTMLParagraphElement | null;
    const verifySubmit = document.getElementById('verify-submit') as HTMLButtonElement | null;
    const verifyResend = document.getElementById('verify-resend') as HTMLButtonElement | null;
    const verifyClose = document.getElementById('verify-close');

    function openVerifyModal(email: string) {
      if (verifySentTo) verifySentTo.textContent = `Hemos enviado un código a ${email}.`;
      if (verifyCodeInput) verifyCodeInput.value = '';
      verifyError?.classList.add('is-hidden');
      verifyOverlay?.classList.remove('is-hidden');
      verifyCodeInput?.focus();
    }
    function closeVerifyModal() {
      verifyOverlay?.classList.add('is-hidden');
    }

    verifyClose?.addEventListener('click', () => {
      closeVerifyModal();
      setSubmitting(false);
    });
    verifyOverlay?.addEventListener('click', (e) => {
      if (e.target === verifyOverlay) {
        closeVerifyModal();
        setSubmitting(false);
      }
    });

    verifyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      verifyError?.classList.add('is-hidden');
      const code = verifyCodeInput?.value.trim();
      if (!code || !pendingIdentity || !pendingMode || !pendingBooking) return;

      if (verifySubmit) {
        verifySubmit.disabled = true;
        verifySubmit.textContent = 'Verificando…';
      }

      try {
        const res = await fetch('/api/auth/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: pendingMode, email: pendingIdentity.email, code })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.message || 'Código incorrecto.');

        const result = await submitBooking(pendingBooking);
        if (!result.ok) throw new Error(result.message);

        window.location.href = `/pago?booking=${result.data.id}`;
      } catch (err: any) {
        if (verifyError) {
          verifyError.textContent = err?.message || 'No se ha podido verificar el código.';
          verifyError.classList.remove('is-hidden');
        }
        if (verifySubmit) {
          verifySubmit.disabled = false;
          verifySubmit.textContent = 'Verificar y reservar';
        }
        setSubmitting(false);
      }
    });

    verifyResend?.addEventListener('click', async () => {
      if (!pendingIdentity) return;
      verifyResend.disabled = true;
      try {
        const res = await fetch('/api/auth/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(pendingIdentity)
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.message || 'No se ha podido reenviar el código.');
        pendingMode = data.mode;
        if (verifySentTo) verifySentTo.textContent = `Hemos enviado un nuevo código a ${pendingIdentity.email}.`;
      } catch (err: any) {
        if (verifyError) {
          verifyError.textContent = err?.message || 'No se ha podido reenviar el código.';
          verifyError.classList.remove('is-hidden');
        }
      } finally {
        verifyResend.disabled = false;
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.reload();
    });

    // --- Main submit ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      if (!tourSelect.value) {
        showError('Selecciona una ruta.');
        return;
      }
      if (!horaSelect.value) {
        showError('Selecciona una hora de inicio.');
        return;
      }

      if (currentAvailability && currentAvailability.remaining !== null) {
        const guests = Number(guestsInput.value);
        if (currentAvailability.remaining <= 0) {
          showError('No quedan plazas para esta fecha y hora. Elige otra.');
          return;
        }
        if (guests > currentAvailability.remaining) {
          showError(`Solo quedan ${currentAvailability.remaining} plaza(s) para esta salida.`);
          return;
        }
      }

      const bookingPayload = {
        tourId: tourSelect.value,
        tourDate: fechaInput.value,
        tourScheduleId: horaSelect.value,
        guests: Number(guestsInput.value)
      };

      if (isAuthenticated) {
        setSubmitting(true);
        const result = await submitBooking(bookingPayload);
        if (result.ok) {
          window.location.href = `/pago?booking=${result.data.id}`;
        } else {
          showError(result.message);
          setSubmitting(false);
        }
        return;
      }

      // Guest flow — collect + validate their details, then send a
      // verification code. Verifying it either logs them into an existing
      // account or creates a new one (see /api/auth/start).
      if (!nombreInput?.value.trim() || !apellidosInput?.value.trim()) {
        showError('Introduce tu nombre y apellidos.');
        return;
      }
      const email = emailInput?.value.trim() ?? '';
      if (!email) {
        showError('Introduce tu correo electrónico.');
        return;
      }

      pendingBooking = bookingPayload;
      pendingIdentity = {
        fullName: `${nombreInput.value} ${apellidosInput.value}`.trim(),
        email,
        phone: telefonoInput?.value.trim() || undefined
      };

      setSubmitting(true);
      try {
        const res = await fetch('/api/auth/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(pendingIdentity)
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.message || 'No se ha podido enviar el código de verificación.');

        pendingMode = data.mode;
        openVerifyModal(email);
      } catch (err: any) {
        showError(err?.message || 'No se ha podido enviar el código de verificación.');
      } finally {
        setSubmitting(false);
      }
    });

    if (tourSelect.value) {
      loadSchedulesForSelectedTour();
    } else {
      updateSummary();
    }
  }
</script>