---
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";
import { getCurrentCustomer } from "@/lib/api.js";
import { getSessionToken, clearSessionCookie } from "@/lib/session.js";

export const prerender = false;

const redirectTo = Astro.url.searchParams.get("redirect") || "/";
const prefillEmail = Astro.url.searchParams.get("email") || "";

const token = getSessionToken(Astro.cookies);
if (token) {
  try {
    await getCurrentCustomer(token);
    return Astro.redirect(redirectTo);
  } catch {
    clearSessionCookie(Astro.cookies);
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — Tours Meriyo Dublín</title>
    <link rel="icon" href="/public/web-icon-orange.svg" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500;1,600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <section class="auth-page">
        <div class="wrap auth-page__wrap">
          <div class="auth-card">
            <p class="eyebrow">Bienvenido de nuevo</p>
            <h1 class="auth-card__title">Iniciar sesión</h1>
            <p class="auth-card__text">
              Te enviaremos un código de un solo uso a tu correo. No necesitas contraseña.
            </p>

            <form id="step-email-form" novalidate>
              <div class="field">
                <label for="email">Correo electrónico<em>*</em></label>
                <input type="email" id="email" name="email" required value={prefillEmail} />
              </div>
              <p class="auth-error is-hidden" id="email-error" role="alert"></p>
              <button type="submit" class="btn orange-btn auth-card__submit" id="email-submit">
                Enviar código
              </button>
            </form>

            <form id="step-code-form" class="is-hidden" novalidate>
              <p class="auth-card__sent" id="sent-to"></p>
              <div class="field">
                <label for="code">Código de verificación<em>*</em></label>
                <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required />
              </div>
              <p class="auth-error is-hidden" id="code-error" role="alert"></p>
              <button type="submit" class="btn orange-btn auth-card__submit" id="code-submit">
                Verificar y entrar
              </button>
              <div class="auth-card__links">
                <button type="button" class="link-btn" id="resend-btn">Reenviar código</button>
                <button type="button" class="link-btn" id="back-btn">Usar otro correo</button>
              </div>
            </form>

            <p class="auth-card__footer">
              ¿No tienes cuenta todavía?
              <a href={`/crear-cuenta?redirect=${encodeURIComponent(redirectTo)}`}>Crea una</a>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="sobre-mi">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__logo">Tours <em>Meriyo</em> Dublín</p>
          <p class="site-footer__text">
            Guías locales, grupos reducidos y el Dublín que no sale en las postales.
          </p>
        </div>
        <p class="site-footer__copy">© {new Date().getFullYear()} Tours Meriyo Dublín</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-footer {
    background: var(--forest-deep);
    color: var(--parchment-alt);
    padding-block: 40px;
    border-top: 1px solid var(--line);
  }
  .site-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .site-footer__logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--cream);
    margin: 0 0 8px;
  }
  .site-footer__logo em { color: var(--gold); }
  .site-footer__text {
    max-width: 46ch;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--parchment-alt);
    margin: 0;
  }
  .site-footer__copy {
    font-size: 0.78rem;
    color: rgba(242, 234, 215, 0.6);
    margin: 0;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .footer__social svg {
    width: 32px;
    height: 32px;
    display: block;
  }
  .auth-page { background: var(--parchment); min-height: 70vh; display: flex; align-items: center; padding-block: 60px; }
  .auth-page__wrap { display: flex; justify-content: center; }
  .auth-card {
    width: 100%; max-width: 440px;
    background: var(--cream);
    border: 1px solid rgba(24, 34, 25, 0.1);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 34px 32px 30px;
  }
  .auth-card__title { font-family: var(--font-display); font-weight: 600; font-size: 1.8rem; color: var(--ink); margin: 8px 0 10px; }
  .auth-card__text { font-size: 0.92rem; line-height: 1.55; color: #5a6b5c; margin: 0 0 24px; }
  .auth-card__sent { font-size: 0.88rem; color: #5a6b5c; margin: 0 0 16px; }
  .auth-card .field { margin-bottom: 18px; }
  .auth-card label { display: block; font-size: 0.82rem; font-weight: 600; color: #4a5b4c; margin-bottom: 7px; }
  .auth-card label em { font-style: normal; color: var(--russet); margin-left: 2px; }
  .auth-card input[type="email"], .auth-card input[type="text"], .auth-card input[type="tel"] {
    width: 100%; font-family: var(--font-body); font-size: 0.95rem; color: var(--ink);
    background: var(--cream); border: 1px solid rgba(24, 34, 25, 0.22); border-radius: var(--radius); padding: 12px 14px;
  }
  .auth-card input:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(233, 151, 10, 0.16); }
  .auth-card__submit { width: 100%; justify-content: center; margin-top: 4px; }
  .auth-card__submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .field__optional { font-weight: 400; color: #8a8272; }

  .auth-error {
    font-size: 0.85rem; color: #7a2e1f; background: rgba(158, 73, 54, 0.1);
    border-left: 3px solid var(--russet); padding: 10px 14px; border-radius: var(--radius); margin: 0 0 16px;
  }
  .auth-error.is-hidden { display: none; }

  .auth-card__links { display: flex; justify-content: space-between; margin-top: 14px; }
  .link-btn { background: none; border: none; font-family: var(--font-body); font-size: 0.82rem; color: var(--russet); cursor: pointer; padding: 4px 0; }
  .link-btn:hover { text-decoration: underline; }
  .link-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .auth-card__footer { text-align: center; font-size: 0.85rem; color: #5a6b5c; margin: 24px 0 0; }
  .auth-card__footer a { color: var(--russet); text-decoration: underline; }

  .is-hidden { display: none; }
</style>

<script define:vars={{ redirectTo }}>
  const emailForm = document.getElementById('step-email-form');
  const emailInput = document.getElementById('email');
  const emailError = document.getElementById('email-error');
  const emailSubmit = document.getElementById('email-submit');

  const codeForm = document.getElementById('step-code-form');
  const codeInput = document.getElementById('code');
  const codeError = document.getElementById('code-error');
  const codeSubmit = document.getElementById('code-submit');
  const sentTo = document.getElementById('sent-to');
  const resendBtn = document.getElementById('resend-btn');
  const backBtn = document.getElementById('back-btn');

  let currentEmail = '';

  function showError(el, message) { el.textContent = message; el.classList.remove('is-hidden'); }
  function clearError(el) { el.textContent = ''; el.classList.add('is-hidden'); }

  async function requestCode(email) {
    const res = await fetch('/api/auth/login/request-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data?.message || 'No se ha podido enviar el código.');
    return data;
  }

  emailForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError(emailError);
    const email = emailInput.value.trim();
    if (!email) return;

    emailSubmit.disabled = true;
    emailSubmit.textContent = 'Enviando…';
    try {
      await requestCode(email);
      currentEmail = email;
      sentTo.textContent = `Hemos enviado un código a ${email}.`;
      emailForm.classList.add('is-hidden');
      codeForm.classList.remove('is-hidden');
      codeInput.value = '';
      codeInput.focus();
    } catch (err) {
      showError(emailError, err.message);
    } finally {
      emailSubmit.disabled = false;
      emailSubmit.textContent = 'Enviar código';
    }
  });

  codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError(codeError);
    const code = codeInput.value.trim();
    if (!code) return;

    codeSubmit.disabled = true;
    codeSubmit.textContent = 'Verificando…';
    try {
      const res = await fetch('/api/auth/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'login', email: currentEmail, code })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.message || 'Código incorrecto.');
      window.location.href = redirectTo || '/';
    } catch (err) {
      showError(codeError, err.message);
      codeSubmit.disabled = false;
      codeSubmit.textContent = 'Verificar y entrar';
    }
  });

  resendBtn.addEventListener('click', async () => {
    if (!currentEmail) return;
    resendBtn.disabled = true;
    try {
      await requestCode(currentEmail);
      sentTo.textContent = `Hemos enviado un nuevo código a ${currentEmail}.`;
    } catch (err) {
      showError(codeError, err.message);
    } finally {
      resendBtn.disabled = false;
    }
  });

  backBtn.addEventListener('click', () => {
    codeForm.classList.add('is-hidden');
    emailForm.classList.remove('is-hidden');
  });
</script>